post_install() {
	# Same capabilities as Hebnix's own "Grant Permission" button
	# (multiplayer_lan::GRANTED_CAPS): cap_net_admin/cap_net_raw for Workshop
	# LAN multiplayer (its own tailscaled, beacon relay + nftables rules),
	# cap_net_bind_service for the spoofer/replay proxy on port 443. Setting
	# them here means no permission prompt and no restart inside Hebnix, and
	# upgrades (which replace the binary and drop file capabilities) keep them.
	setcap cap_net_admin,cap_net_raw,cap_net_bind_service=eip /usr/bin/hebnix 2>/dev/null || \
		echo "==> Note: could not set capabilities on /usr/bin/hebnix. Use Grant Permission in Hebnix, or run: sudo setcap cap_net_admin,cap_net_raw,cap_net_bind_service=eip /usr/bin/hebnix"

	cat <<'EOF'
==> Hebnix installed. To run: hebnix

==> Optional, for hotkeys/binds/controller reading and chat-send plugins
    (e.g. quick-chat) that send synthetic input:
      sudo usermod -aG input "$USER"
    then log out and back in (or reboot) for it to take effect.
    A udev rule + uinput module config are already installed by this
    package; only group membership needs a one-time manual step.

==> Config, plugins and themes live in $XDG_CONFIG_HOME/hebnix
    (~/.config/hebnix by default) and are managed by Hebnix itself --
    untouched by installing, upgrading, or removing this package.
EOF
}

post_upgrade() {
	post_install
}
